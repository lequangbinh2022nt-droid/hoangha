@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">

    <title>Body Layout - Hoàng Hà PC</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        /* --- cài đặt body --- */
        * {
            box-sizing: border-box; /* phần này mình cài chữ và chỉnh lay out*/
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #85a1eb11; /* Màu nền xanh nhạt của toàn trang */
            padding: 30px;
            display: flex;
            text-align: center;
        }

        /*  Khung chứa chính (Main Container)  */
        .main-container {
            display: flex; /* sắp xếp linh hoạt các phần tử con*/
            max-width: 1400px;
            width: 100%;
            gap: 20px; /* Khoảng cách giữa các bảng */
        }

        /* cột bên trái */
        .sidebar {
            width: 260px;
            background-color: white;
            border-radius: 10px; /* bo tròn*/
            padding: 10px 0;
            height: fit-content; /*tự căn chỉnh co giản*/
            /*box-shadow: 0 2px 5px rgba(0,0,0,0.05);*/
            /*flex-shrink: 5;*/ /* đổ bóng */
        }

            .sidebar ul {
                list-style: none;
            }

                .sidebar ul li {
                    padding: 12px 20px;
                    font-size: 14px;
                    color: #333;
                    border-bottom: 1px solid #f0f0f0; /*tạo đường viền */
                    display: flex;
                    justify-content: space-between; /*đẩy chữ sang trái mũi tên sang phải */
                    align-items: center;
                    cursor: pointer; /* đổi con chuột chạm tay vào thành hình bàn tay  */
                    transition: background 0.2s;
                }

                    .sidebar ul li:hover {
                        background-color: #f9f9f9;
                        color: #1a5cff;
                    }



                    .sidebar ul li .arrow { /* chỉnh dấu mũi tên */
                        color: #ccc;
                        font-size: 18px;
                    }

        /*cột nội dung chính main content */
        .content {
            flex: 1; /* Chiếm toàn bộ không gian còn lại */
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* hàng banner trên */
        .banner-row-top {
            display: flex;
            gap: 20px;
            height: 450px;
        }

        .banner-main {
            flex: 2; /* Chiếm 2/3 diện tích */
            border-radius: 10px;
            background-color: #2a6df4; 
            background-image: url('https://hoanghapccdn.com/media/banner/11_07-eb3020c77c422bc618fb81c7d145d64c.jpg'); /* hình bự nhất*/
            background-size: cover;
            background-position: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .banner-side {
            flex: 1; /* chiếm 1/3 diện tích */
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .banner-side-item {
            flex: 1;
            border-radius: 10px;
            background-size: cover;
            background-position: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .banner-warranty {
            background-image: url('https://hoanghapccdn.com/media/banner/25_07-27177788c1abdeaa03198eef16be91b8.jpg'); /* gắn hình bảo hành */
        }

        .banner-clean {
            background-image: url('https://hoanghapccdn.com/media/banner/24_06-7d419799c1b51ad8e704875feb439120.jpg'); /*bảo hành máy*/
        }

        /* hàng dưới */
        .banner-row-bottom {
            display: flex;
            gap: 20px;
            height: 220px;
        }

        .banner-small {
            flex: 1;
            border-radius: 10px;
            background-size: cover;
            background-position: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .banner-ai {
            background-image: url('https://hoanghapccdn.com/media/banner/24_06-9771fd58a1c51fa5a3ac9f98c8b9d329.jpg'); /* hình pc ai training */
        }

        .banner-graphic {
            background-image: url('https://hoanghapccdn.com/media/banner/24_06-2b205f35faa61c359ba7aecbc705b88c.jpg'); /* hình pc thiết kế đồ họa*/
        }

        .banner-render {
            background-image: url('https://hoanghapccdn.com/media/banner/24_06-addedeed551f1edc3f78e86f37b7619c.jpg'); /* hình pc edit video*/
        }
    </style>
</head>
<body>

    <!-- phần body-->
    <div class="main-container">

        <!-- cột menu bên trái -->
        <aside class="sidebar">
            <ul>
                <li>
                    <a href="http://localhost:52423/Home/pcgiare" >
                        <span class="icon"><i class="fa-solid fa-desktop"></i></span>PC Giá Rẻ<span class="arrow">›</span>
                    </a>
                </li>
                <li>
                    <a href="http://localhost:52423/Home/cpu" >
                        <span class="icon"><i class="fa-solid fa-microchip"></i></span> CPU - Bộ Vi Xử Lý <span class="arrow">›</span>
                    </a>
                </li>
                <li>
                    <a href="http://localhost:52423/Home/vag">
                        <span class="icon"><i class="fa-solid fa-gamepad"></i></span> VGA - Card Màn Hình <span class="arrow">›</span>
                    </a>
                </li>
                <li>
                    <a href="http://localhost:52423/Home/lkmt" >
                        <span class="icon"><i class="fa-solid fa-screwdriver-wrench"></i></span> Linh Kiện Máy Tính <span class="arrow">›</span>
                    </a>
                </li>
               <li>
                   <a href="http://localhost:52423/Home/mhmt" >
                       <span class="icon"><i class="fa-solid fa-tv"></i></span> Màn Hình Máy Tính <span class="arrow">›</span>
                   </a>
               </li>
              <li>
                  <a href="http://localhost:52423/Home/tncoling">
                      <span class="icon"><i class="fa-solid fa-fan"></i></span> Tản Nhiệt Cooling <span class="arrow">›</span>
                  </a>
              </li>
               <li>
                   <a href="http://localhost:52423/Home/gaming">
                       <span class="icon"><i class="fa-solid fa-computer-mouse"></i></span> Gaming Gear <span class="arrow">›</span>
                   </a>
               </li>
              <li>
                  <a href="http://localhost:52423/Home/tbm" >
                      <span class="icon"><i class="fa-solid fa-wifi"></i></span> Thiết Bị Mạng <span class="arrow">›</span>
                  </a>  
              </li>
             
            </ul>
        </aside>

        <!-- nội dung chính của banner -->
        <main class="content">
            <!-- hàng banner trên -->
            <div class="banner-row-top">
                <div class="banner-main">
                    <!-- hình ảnh bự nhất  -->
                </div>
                <div class="banner-side">
                    <div class="banner-side-item banner-warranty">
                        <!-- bảo hành -->
                    </div>
                    <div class="banner-side-item banner-clean">
                        <!-- vệ sinh máy pc -->
                    </div>
                </div>
            </div>

            <!-- hàng banner dưới -->
            <div class="banner-row-bottom">
                <div class="banner-small banner-ai"></div>
                <div class="banner-small banner-graphic"></div>
                <div class="banner-small banner-render"></div>
            </div>
        </main>

    </div>

</body>
</html>